{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/db/schema": ["./src/db/d1/schema.ts"],
      "@/db/connection.server": ["./src/db/d1/connection.server.ts"],
      "@/db/journal-context.server": ["./src/db/d1/journal-context.server.ts"],
      "@/db/journal-mutations.server": [
        "./src/db/d1/journal-mutations.server.ts"
      ],
      "@/lib/server/auth/database-adapter.server": [
        "./src/db/d1/auth-database-adapter.server.ts"
      ],
      "@/lib/storage": ["./src/cloudflare/storage.server.ts"],
      "@/lib/thumbnail-image": ["./src/cloudflare/images.server.ts"],
      "@/lib/server/auth/email.server": [
        "./src/cloudflare/auth-email.server.ts"
      ],
      "@/db": ["./src/db/d1/index.ts"],
      "@/*": ["./src/*"],
      "@/lib/server/auth/identity.server": [
        "./src/cloudflare/auth/identity.server.ts"
      ],
      "@/lib/server/auth/account.server": [
        "./src/cloudflare/auth/account.server.ts"
      ],
      "@/lib/server/auth/integrations.server": [
        "./src/cloudflare/auth/integrations.server.ts"
      ],
      "@/lib/server/ai-request-accounting.server": [
        "./src/cloudflare/ai-request-accounting.server.ts"
      ],
      "@/lib/server/auth/oauth-coordination.server": [
        "./src/cloudflare/oauth-coordination.server.ts"
      ],
      "@/lib/server/auth/jobs.server": ["./src/cloudflare/auth/jobs.server.ts"],
      "@/lib/server/health": ["./src/cloudflare/health.server.ts"],
      "@/lib/server/remote-url-policy.server": [
        "./src/cloudflare/remote-url-policy.server.ts"
      ],
      "@/lib/server/remote-image.server": [
        "./src/cloudflare/remote-image.server.ts"
      ],
      "@/lib/server/ai-provider-fetch.server": [
        "./src/cloudflare/ai-provider-fetch.server.ts"
      ],
      "@better-auth/cimd/node": ["./src/cloudflare/cimd-fetch.server.ts"],
      "@/db/sql-dialect.server": ["./src/db/d1/sql-dialect.server.ts"],
      "@/lib/server/database-error.server": [
        "./src/cloudflare/database-error.server.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "design",
    "**/*.test.ts",
    "packages/journal-demo",
    "src/db/index.ts",
    "src/db/connection.server.ts",
    "src/db/journal-context.server.ts",
    "src/db/journal-mutations.server.ts",
    "src/lib/server/media-handler.ts",
    "src/lib/server/auth/identity.server.ts",
    "src/lib/server/auth/defaults.server.ts",
    "src/lib/server/auth/account.server.ts",
    "src/lib/server/auth/integrations.server.ts",
    "src/lib/server/auth/database-adapter.server.ts",
    "src/lib/server/ai-request-accounting.server.ts",
    "src/lib/server/auth/oauth-coordination.server.ts",
    "src/lib/server/auth/oauth-lock.server.ts",
    "src/lib/server/auth/jobs.server.ts",
    "src/lib/server/health.ts",
    "src/lib/server/remote-url-policy.server.ts",
    "src/lib/server/remote-image.server.ts",
    "src/lib/server/ai-provider-fetch.server.ts",
    "src/db/sql-dialect.server.ts",
    "src/lib/server/database-error.server.ts"
  ]
}
