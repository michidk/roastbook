{
  "name": "roastbook",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:log": "mkdir -p logs && bun run dev 2>&1 | tee logs/dev.log",
    "generate-routes": "tsr generate",
    "build": "vite build && bun run scripts/build-service-worker.ts .output/public",
    "build:demo": "bun run scripts/generate-demo-snapshot.ts & snapshot=$!; ROASTBOOK_EDITION=demo vite build && wait $snapshot && bun run scripts/copy-pglite-assets.ts && bun run scripts/build-demo-pwa.ts .vercel/output/static && bun run scripts/check-pwa.ts --demo .vercel/output/static",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:code && bun run check:docs",
    "check:code": "biome check . && bun run check:boundaries && bun run check:ai-pricing",
    "check:boundaries": "bun run scripts/check-import-boundaries.ts",
    "check:ai-pricing": "bun run scripts/sync-ai-pricing.ts --check",
    "check:docs": "markdownlint-cli2 \"README.md\" \"AGENTS.md\" \"DESIGN.md\" \"docs/**/*.md\" \"charts/**/*.md\"",
    "check:client-assets": "bun run scripts/check-client-assets.ts",
    "check:pwa": "bun run scripts/check-pwa.ts",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:deadcode": "knip",
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:coverage": "bun test --coverage --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun run scripts/test-integration.ts",
    "verify": "bun run check && bun run typecheck && bun run test && bun run lint:deadcode && bun run build && bun run check:client-assets && bun run check:pwa",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:cli": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "db:duplicate-roasters": "bun run scripts/find-duplicate-roasters.ts",
    "storage:orphans": "bun run scripts/report-media-orphans.ts",
    "storage:backfill-thumbnails": "bun run scripts/backfill-thumbnails.ts",
    "sync:ai-pricing": "bun run scripts/sync-ai-pricing.ts",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "worker": "bun run scripts/account-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@base-ui/react": "^1.5.0",
    "@better-auth/cimd": "1.7.15",
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@modelcontextprotocol/server": "^2.4.0",
    "@simplewebauthn/server": "14.0.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "archiver": "^8.0.0",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.0.0",
    "maplibre-gl": "^6.4.1",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "rxdb": "17.6.0",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@biomejs/biome": "2.6.4",
    "@electric-sql/pglite": "0.5.13",
    "@modelcontextprotocol/client": "^2.4.0",
    "@opencode-ai/models": "0.0.119",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.46",
    "@types/archiver": "^8.0.0",
    "@types/bun": "1.4.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "fake-indexeddb": "6.2.6",
    "knip": "6.44.0",
    "markdownlint-cli2": "0.24.0",
    "nitro": "3.0.260610-beta",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "smol-toml": "^1.8.0",
    "rxdb": "17.6.0",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "re2js": "^2.8.7",
    "katex": "^0.18.2"
  }
}
