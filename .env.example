# Database
DATABASE_URL=postgresql://roastbook:roastbook@localhost:5432/roastbook

# Built-in passwordless authentication (docker-compose.auth.yaml)
# Authentication is independent of the read-only demo edition.
AUTH_ENABLED=false
# AUTH_URL=https://coffee.example.com
# AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# Signup is closed by default; listed addresses can still create accounts.
# AUTH_SIGNUP_ENABLED=false
# AUTH_ADMIN_EMAIL=owner@example.com,second-admin@example.com
# AUTH_ALLOWED_EMAILS=friend@example.com
# DEPLOYMENT_MODE=self-hosted
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=Roastbook <coffee@example.com>
# SMTP_URL=smtps://username:password@smtp.example.com:465
# RESEND_API_KEY=...
# AUTH_IP_HEADER=x-real-ip

# Optional Hodor gate for the authentication-disabled Docker Compose example
HODOR_PASSWORD=change-me
# Generate with: openssl rand -hex 32
HODOR_SECRET=replace-with-a-random-secret
# HODOR_PORT=3000
# Override only when deliberately updating the pinned image.
# HODOR_IMAGE=ghcr.io/michidk/hodor@sha256:...
# HODOR_TITLE=Roastbook Login
# HODOR_SESSION_TTL=86400
# Set to true when accessing Compose through HTTPS
# HODOR_SECURE_COOKIE=false
# HODOR_LOG_FORMAT=compact

# MCP uses per-user bearer tokens in both authentication modes.
# Generate one in Settings > AI access (MCP). The device port is loopback-only.
# MCP_PORT=3001
# MCP_ALLOWED_HOSTS=roastbook.tailnet.example
# MCP_ALLOWED_ORIGINS=

# Storage (optional - defaults to local)
# STORAGE_PROVIDER=local
# STORAGE_PATH=./uploads
# STORAGE_URL=/media
# VITE_STORAGE_URL=/media

# Trusted build-time markup inserted before </head> (optional)
# Never populate this from untrusted or user-provided content.
# VITE_HEAD_HTML=<meta name="robots" content="noindex">

# S3 Storage (if STORAGE_PROVIDER=s3)
# S3_BUCKET=roastbook
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# OpenAI-compatible AI (optional - image extraction and web research)
# Generate once with openssl rand -base64 32; keep it with database backups.
# Each user connects their own provider in Settings > AI.
# AI_CREDENTIAL_ENCRYPTION_KEY=...
# Self-hosting only: exact origins allowed to reach a local AI service.
# AI_ALLOWED_PRIVATE_ORIGINS=http://ollama:11434
