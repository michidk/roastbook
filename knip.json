{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreIssues": {
    "src/components/ui/card.tsx": ["exports"],
    "src/components/ui/combobox.tsx": ["exports"],
    "src/components/ui/dropdown-menu.tsx": ["exports"],
    "src/components/ui/input-group.tsx": ["exports"],
    "src/components/ui/select.tsx": ["exports"],
    "src/components/ui/table.tsx": ["exports"],
    "src/components/ui/tooltip.tsx": ["exports"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["tailwindcss", "@roastbook/journal-demo", "tslib"],
  "workspaces": {
    "packages/journal-demo": {
      "entry": ["src/**/*.ts", "src/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    ".": {
      "entry": [
        "src/routes/**/*.tsx",
        "src/router.tsx",
        "src/server.ts",
        "src/start.ts",
        "src/lib/server/media-handler.ts",
        "src/**/*.test.ts",
        "scripts/**/*.ts",
        "scripts/**/*.mjs",
        "src/components/edition-ui.tsx",
        "src/journal/platform/*.browser.ts",
        "src/journal/local/pglite-types.ts",
        "src/journal/local/worker.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}", "*.config.ts"]
    }
  }
}
